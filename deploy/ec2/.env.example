# Copy to .env on the server and fill in. Never commit the real file.
#   cp .env.example .env && chmod 600 .env

# ---- Database (used by both the postgres container and the API) -----------
POSTGRES_USER=cis_app
POSTGRES_PASSWORD=CHANGE_ME_long_random
POSTGRES_DB=cis

# The API talks to postgres over the internal compose network, so the host is
# the service name, not localhost.
DATABASE_URL=postgresql://cis_app:CHANGE_ME_long_random@postgres:5432/cis?schema=public
REDIS_URL=redis://redis:6379

# ---- Runtime --------------------------------------------------------------
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Both must be the public HTTPS origin. WEB_BASE_URL is the CORS allow-list.
API_BASE_URL=https://cis.example.com
WEB_BASE_URL=https://cis.example.com

# ---- Auth -----------------------------------------------------------------
# openssl rand -base64 48   (a different value for each)
JWT_ACCESS_SECRET=CHANGE_ME_at_least_32_characters_long
JWT_REFRESH_SECRET=CHANGE_ME_different_value_32_chars_min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=24h

# ---- Email ----------------------------------------------------------------
# 'console' only prints invitations to the log. Use smtp in production.
EMAIL_DRIVER=smtp
EMAIL_FROM="CIS Technologies <no-reply@cis.example.com>"
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ---- Calendar -------------------------------------------------------------
CALENDAR_DRIVER=none
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://cis.example.com/api/v1/integrations/google/callback

# ---- Web push -------------------------------------------------------------
# node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@cis.example.com

# ---- Limits ---------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
