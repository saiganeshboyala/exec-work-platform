# ---- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173

# ---- Datastores ----------------------------------------------------------
DATABASE_URL=postgresql://ewp:ewp_local_password@localhost:5432/ewp?schema=public
REDIS_URL=redis://localhost:6379

# ---- Auth ----------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
INVITATION_TTL_DAYS=14

# ---- Email ---------------------------------------------------------------
# EMAIL_DRIVER: console | smtp
EMAIL_DRIVER=console
EMAIL_FROM="Exec Work Platform <no-reply@example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ---- Calendar ------------------------------------------------------------
# CALENDAR_DRIVER: none | google | microsoft
CALENDAR_DRIVER=none
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback

# ---- Limits --------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ---- Web Push ------------------------------------------------------------
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave blank to disable browser push; the in-app notification centre still works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@example.com
